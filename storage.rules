rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMonitoramentoEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'adson.sousa@rjalimentos.com.br',
          'kathellen.silva@rjalimentos.com.br',
          'anderson.silva@rjalimentos.com.br'
        ];
    }

    function isGestao() {
      return isSignedIn() && (
        request.auth.token.role == 'Monitoramento' ||
        request.auth.token.role == 'Operacao' ||
        isMonitoramentoEmail()
      );
    }

    function isMotorista() {
      return isSignedIn() && request.auth.token.role == 'Motorista' && request.auth.token.placa != null;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de hodômetro (KM), recibos de despesas e canhotos arquivados
    match /{folder}/{allPaths=**} {
      allow read: if isGestao() || isMotorista();
      allow create, update: if (isGestao() || isMotorista()) && isValidImageUpload();
      allow delete: if isGestao();
    }
  }
}
